# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Generate with: uv run python manage_users.py secret
SECRET_KEY=

# auto = set Secure cookie flag when TLS certs are present (recommended)
COOKIE_SECURE=auto

# Listening port — auto-selects 5443 when TLS certs are present, 5000 otherwise
# PORT=5000

# TLS certificate paths (relative to project root)
# SSL_CERT=certs/cert.pem
# SSL_KEY=certs/key.pem

# Set to the number of trusted reverse proxies in front of this app (e.g. 1 for nginx).
# TRUSTED_PROXY_COUNT=1

# FortiAnalyzer client (app/faz_client.py)
# FAZ_VERIFY_SSL=false
# FAZ_REQUEST_TIMEOUT=30

# SNMPv3 health polling for the Dashboard tab — off by default; CPU/mem
# stay blank on health cards until enabled. Per-target snmp_user/snmp_auth_key/
# snmp_priv_key in faz_targets.json override these.
# SNMP_ENABLED=false
# SNMP_PORT=161
# SNMP_TIMEOUT=5
# SNMP_RETRIES=1
# SNMP_POLL_INTERVAL=60
# SNMP_USER=
# SNMP_AUTH_PROTOCOL=SHA
# SNMP_AUTH_KEY=
# SNMP_PRIV_PROTOCOL=AES
# SNMP_PRIV_KEY=

# Silent device detection and log stats polling for the external API
# SILENT_DEVICE_THRESHOLD_MINUTES=60
# LOG_STATS_POLL_INTERVAL=300

# Threat activity polling for the external API — unacked FAZ alerts by
# severity and 24h IPS detection activity (see README.md)
# THREAT_STATS_POLL_INTERVAL=900

# Host CPU/Memory/Disk polling for the Admin > Host Metrics panel
# HOST_METRICS_POLL_INTERVAL=60

# Dashboard health card thresholds (percent)
# CPU_WARN=70
# CPU_CRIT=90
# MEM_WARN=70
# MEM_CRIT=90

# Log Search tab (fixed result cap, poll timing for the submit/poll/fetch loop)
# LOG_SEARCH_MAX_RESULTS=1000
# LOG_SEARCH_POLL_INTERVAL=2.0
# LOG_SEARCH_TIMEOUT=60.0
